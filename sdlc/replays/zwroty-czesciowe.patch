+
+    public Payment refundPartially(String paymentId, Money amount) {
+        Payment payment = payments.findById(paymentId)
+                .orElseThrow(() -> new IllegalArgumentException("Nie ma płatności " + paymentId));
+        gateway.refund(payment.id(), amount, "refund-" + payment.id());
+        Money refunded = payment.refunded().plus(amount);
+        PaymentStatus status = refunded.equals(payment.amount()) ? PaymentStatus.REFUNDED : PaymentStatus.CAPTURED;
+        Payment updated = new Payment(payment.id(), payment.orderId(), payment.amount(), refunded, status);
+        payments.save(updated);
+        return updated;
+    }
 }
