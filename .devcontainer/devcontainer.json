// Warsztat w przeglądarce: GitHub Codespaces na Twoim forku. Cały stos (kind, Argo, kagent, Kyverno, Jaeger)
// działa w kontenerze codespace'a przez Docker-in-Docker, więc na laptopie nie instalujesz niczego.
// Konto GitHub Free ma w miesiącu 120 core-godzin i 15 GB: maszyna 4-rdzeniowa to 30 godzin pracy.
// Po wyczerpaniu limitu bez karty GitHub blokuje dalsze użycie, nie wystawia rachunku.
{
  "name": "Fabryka oprogramowania od podstaw",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem", "installMaven": "true" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sudo sysctl -q -w fs.inotify.max_user_watches=524288 fs.inotify.max_user_instances=512 || true",
  "postAttachCommand": "cat ~/.local/share/fabryka/witaj.txt 2>/dev/null || cat .devcontainer/witaj.txt 2>/dev/null || true",
  "forwardPorts": [2746, 8082, 8083, 16686],
  "portsAttributes": {
    "2746": { "label": "Hala (Argo Workflows)", "onAutoForward": "silent" },
    "8082": { "label": "kagent dashboard", "onAutoForward": "silent" },
    "8083": { "label": "kagent A2A (API)", "onAutoForward": "ignore" },
    "16686": { "label": "Jaeger (ślady)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": { "extensions": ["redhat.vscode-yaml", "ms-kubernetes-tools.vscode-kubernetes-tools"] },
    "codespaces": { "openFiles": ["warsztat/start.md"] }
  }
}
