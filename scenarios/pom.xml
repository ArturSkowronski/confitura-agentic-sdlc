<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Scenariusze holdout. Pisze je człowiek (produkt), agent ich nie widzi: job z agentem
       ma sparse checkout bez katalogu scenarios/. Tak jak zbiór testowy w uczeniu maszynowym:
       jeśli model go widzi, przestaje mierzyć cokolwiek. -->
  <groupId>pl.confitura.shop.scenarios</groupId>
  <artifactId>scenarios</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>regresja</module>
    <module>rabat</module>
    <module>zwroty-czesciowe</module>
    <module>sejf-zwroty</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <shop.version>1.0.0-SNAPSHOT</shop.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.14.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>pl.confitura.shop</groupId>
      <artifactId>orders-service</artifactId>
      <version>${shop.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>pl.confitura.shop</groupId>
      <artifactId>payments-service</artifactId>
      <version>${shop.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <includes>
            <include>**/*Scenarios.java</include>
          </includes>
          <!-- w raporcie ląduje @DisplayName, czyli opis zachowania, a nie nazwa metody -->
          <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
          </statelessTestsetReporter>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
