  echo "  Hala: szablon linii";                     echo "    $(url 2746 /workflow-templates/fabryka)"
  echo "  Jaeger: ślady (wybierz serwis, Find Traces)";                    echo "    $(url 16686 /search)"
  echo "  kagent: agenci w klastrze";               echo "    $(url 8082 /)"
