cmd_witaj() {
  local w="$DATA/witaj.txt"
  [ -f "$w" ] && cat "$w" || pomoc
}

cmd_aktualizuj() {
  local tmp; tmp=$(mktemp -d)
  if git rev-parse --show-toplevel >/dev/null 2>&1 && git fetch -q origin main 2>/dev/null && git archive FETCH_HEAD warsztat/narzedzia 2>/dev/null | tar -x -C "$tmp" 2>/dev/null; then :;
  else git -C "$tmp" init -q && git -C "$tmp" fetch -q --depth 1 "$UPSTREAM" main && git -C "$tmp" archive FETCH_HEAD warsztat/narzedzia | tar -x -C "$tmp" || umrzyj "Nie udało się pobrać narzędzi."; fi
  bash "$tmp/warsztat/narzedzia/instaluj.sh"; rm -rf "$tmp"
}

pomoc() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-pomoc}" in
  start) cmd_start ;;
  lekcja) cmd_lekcja "${2:-}" ;;
  mapa) cmd_mapa ;;
  sprawdz|sprawdź) cmd_sprawdz "${2:-}" ;;
  rozwiazanie|rozwiązanie) cmd_rozwiaz "${2:-}" ;;   # dawna nazwa, ten sam deterministyczny skrypt
  autopilot) cmd_autopilot "${2:-}" "${3:-}" ;;
  gotowe) cmd_gotowe "${2:-}" ;;
  rozwiaz|rozwiąż|solve) cmd_rozwiaz "${2:-}" ;;
  zaloguj|login) cmd_zaloguj ;;
  callback) cmd_callback "${2:-}" ;;
  reset) cmd_reset ;;
  adresy|linki) cmd_adresy ;;
  witaj) cmd_witaj ;;
  aktualizuj) cmd_aktualizuj ;;
  sync) repo; sync ;;
  *) pomoc ;;
esac
