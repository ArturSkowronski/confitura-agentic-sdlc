# Wartości na dzień warsztatu. Każdą można nadpisać zmienną środowiskową, np. LLM_MODEL=... make klucz
# Klucz LLM_API_KEY dostajesz na miejscu, nie trzymamy go w repo.
KIND_CLUSTER=${KIND_CLUSTER:-fabryka}
# Model przez API zgodne z OpenAI (OpenRouter). Zmień na https://api.openai.com/v1 i model OpenAI, jeśli masz własny klucz.
LLM_BASE_URL=${LLM_BASE_URL:-https://openrouter.ai/api/v1}
LLM_MODEL=${LLM_MODEL:-anthropic/claude-sonnet-5}
# Obrazy budowane lokalnie i ładowane do kind (make setup).
IMAGE_TAG=${IMAGE_TAG:-lekcja}
